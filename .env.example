# Supabase — copie este arquivo para .env e preencha a anon key
# (a anon key fica em: Dashboard -> Project Settings -> API -> "anon public")
#
# ⚠️⚠️ ESTE ARQUIVO APONTAVA PRO PROJETO ERRADO ATÉ 08/08/2026.
# A URL aqui era `otzemqmlprwhtvfxbvkj`, que é o projeto Supabase INICIAL do app
# — abandonado na unificação. O projeto VIVO, com toda a base da igreja, é
# `hhntwfawfnxvuobhdfkb`. Quem copiasse este arquivo apontava o app pra um banco
# vazio e ia caçar o motivo por horas.
# `scripts/ota.js` já tratava isso como ameaça e ABORTA a publicação se detectar
# a URL antiga — mas o certo é o exemplo não mentir em primeiro lugar.
EXPO_PUBLIC_SUPABASE_URL=https://hhntwfawfnxvuobhdfkb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=COLE_AQUI_SUA_ANON_KEY

# Stripe — usado na aba Generosidade (cartão + Apple Pay).
# Pegue em https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Merchant ID Apple Pay configurado no Apple Developer Portal
EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID=merchant.br.com.cbrio.app
